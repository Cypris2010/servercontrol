# Rust
/target
**/target

# Node / Frontend (Tauri-Oberfläche, folgt)
node_modules/
dist/
.parcel-cache/

# Tauri
src-tauri/target/

# OS / Editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Zugangsdaten gehören NIEMALS ins Repo (Q1) — nur in den OS-Credential-Store.
*.secret
credentials.*
# ...aber das gleichnamige Rust-Modul (Credential-Store-Zugriff) ist Quellcode, kein Secret —
# ohne diese Ausnahme fehlte crates/core/src/credentials.rs seit dem ersten Commit im Repo und
# jeder frische Checkout (z. B. CI) brach mit "file not found for module `credentials`".
!crates/core/src/credentials.rs

# Lokale FTP/SFTP-Testinfrastruktur (tools/test-ftp-sftp) — Uploads und generierte Testkeys.
tools/test-ftp-sftp/data/mods/*
!tools/test-ftp-sftp/data/mods/.gitkeep
tools/test-ftp-sftp/keys/*
!tools/test-ftp-sftp/keys/.gitkeep

# Zugangs-Keypair zum echten Produktivserver (Hetzner) — privater Key darf nie ins Repo.
tools/test-ftp-sftp/prod-keys/id_prod_sftp
tools/test-ftp-sftp/prod-keys/id_prod_sftp.pub
